#include<iostream>
#include<string>

// Conversão de string por input para inteiro

int main()
{
	std::string palavra;
	std::getline(std::cin, palavra);
	int valorxconvertido = std::stoi(palavra);
	std::cout << valorxconvertido << "\n";

	valorxconvertido += 1;
	std::cout << valorxconvertido << "\n";
	return 0;
}
